# PDF Listen Book Configuration
# Copy this file to .env and fill in your values

# API Key for LLM and TTS services
API_KEY=sk-your-api-key-here

# API Base URL (OpenAI compatible format)
# Examples:
#   - Alibaba Dashscope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   - Zhipu AI: https://open.bigmodel.cn/api/paas/v4
#   - Local Ollama: http://127.0.0.1:11434/v1
API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# TTS Model
# Examples:
#   - Alibaba CosyVoice: cosyvoice-v2
#   - OpenAI: tts-1
TTS_MODEL=cosyvoice-v2

# LLM Model (for text optimization)
# Examples:
#   - Alibaba Qwen: qwen-turbo, qwen-plus, qwen-max
#   - Zhipu AI: glm-4
LLM_MODEL=qwen-turbo

# Voice option (depends on TTS model)
# CosyVoice voices: Chelsie, Ethan, Cherry, Danny
VOICE=Chelsie

# Token for the external AstrBot/integration API. Leave empty to disable it.
PDF_LISTEN_INTEGRATION_TOKEN=change-this-to-a-long-random-token
